# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional AI settings — read server-side only, never expose via NEXT_PUBLIC_*.
# No AI_API_KEY (empty) means the mock provider runs the whole pipeline and a
# demo-mode banner is shown; a configured provider never falls back to mock.
# Embeddings are fixed at 1536 dimensions (text-embedding-3-small class) —
# changing models requires a new migration and a full re-embed.
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_EMBED_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini
AI_MAX_INGEST_BYTES=20971520

# OAuth (Google/GitHub) is configured in Supabase, not in app code. For the
# local stack only, export these in the shell that runs `npx supabase start`
# (supabase/config.toml reads them via env(...); they must never be committed):
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
#   SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Hosted providers are configured entirely in the Supabase dashboard.
# See docs/DEVELOPMENT.md "OAuth providers".

# LiveKit — live study meetings (audio/video/screen share). Server-only: read
# by lib/meeting/config.ts, never exposed via NEXT_PUBLIC_*. All three are
# required together; with any of them empty the workspace honestly shows that
# live meetings are unavailable instead of a join button that would fail.
# Local development: see docs/DEVELOPMENT.md "LiveKit meetings".
#   LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GIF search for the community composer — server-side only, never NEXT_PUBLIC_*.
# Both are required together (tenor | giphy); with either empty the composer
# honestly hides the GIF tab and the proxy endpoints answer 503. The browser
# never talks to the provider: search and downloads go through
# /api/communities/gif/* so the provider sees no user identity.
# Local development: see docs/DEVELOPMENT.md "GIF search (communities)".
GIF_PROVIDER=
GIF_API_KEY=
