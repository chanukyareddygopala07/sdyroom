# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional AI settings — read server-side only, never expose via NEXT_PUBLIC_*.
# No AI_API_KEY (empty) means the mock provider runs the whole pipeline and a
# demo-mode banner is shown; a configured provider never falls back to mock.
# Embeddings are fixed at 1536 dimensions (text-embedding-3-small class) —
# changing models requires a new migration and a full re-embed.
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_EMBED_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini
AI_MAX_INGEST_BYTES=20971520

# OAuth (Google/GitHub) is configured in Supabase, not in app code. For the
# local stack only, export these in the shell that runs `npx supabase start`
# (supabase/config.toml reads them via env(...); they must never be committed):
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
#   SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Hosted providers are configured entirely in the Supabase dashboard.
# See docs/DEVELOPMENT.md "OAuth providers".
